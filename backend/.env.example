# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Account → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# Google Gemini API key (AI Studio → Get API key)
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

PORT=8787
